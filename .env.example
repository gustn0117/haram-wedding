# This is an example environment file
# Copy this to .env.local and fill in your values

# API Endpoints (if needed in the future)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Email Configuration (for contact form backend)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# CONTACT_EMAIL=

# GA4 측정 ID (G- 로 시작). 비워 두면 태그가 삽입되지 않는다.
# 서버 빌드는 .env 를 읽지 않으므로 운영 값은 lib/analytics.ts 의 상수에 넣는다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
